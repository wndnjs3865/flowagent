---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { href: '/pricing', label: '가격' },
  { href: '/docs', label: '문서' },
  { href: '/templates', label: '템플릿' },
  { href: '/blog', label: '블로그' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-white/85 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/85"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-bold tracking-tight"
      aria-label="FlowAgent 홈"
    >
      <span
        class="grid h-7 w-7 place-items-center rounded-md bg-brand-600 text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          class="h-4 w-4 fill-current"
          aria-hidden="true"
        >
          <path
            d="M5 3a1 1 0 011-1h8a1 1 0 011 1v14a1 1 0 01-1.6.8L10 14.5l-3.4 3.3A1 1 0 015 17V3z"
          ></path>
        </svg>
      </span>
      FlowAgent
    </a>

    <nav
      class="hidden items-center gap-1 md:flex"
      aria-label="주요 메뉴"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              currentPath === item.href
                ? 'text-zinc-900 dark:text-zinc-100'
                : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <ThemeToggle />

      <!-- Mobile: compact icon CTA so the most important action is always visible -->
      <a
        href="/download"
        class="inline-flex rounded-md bg-brand-600 p-2 text-white shadow-sm hover:bg-brand-700 sm:hidden"
        aria-label="무료 다운로드"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          class="h-4 w-4 fill-current"
          aria-hidden="true"
        >
          <path
            d="M10.75 2.75a.75.75 0 00-1.5 0v8.614L6.295 8.235a.75.75 0 10-1.09 1.03l4.25 4.5a.75.75 0 001.09 0l4.25-4.5a.75.75 0 00-1.09-1.03l-2.955 3.129V2.75z"
          ></path>
          <path
            d="M3.5 12.75a.75.75 0 00-1.5 0v2.5A2.75 2.75 0 004.75 18h10.5A2.75 2.75 0 0018 15.25v-2.5a.75.75 0 00-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5z"
          ></path>
        </svg>
      </a>

      <!-- sm+: full text CTA -->
      <a
        href="/download"
        class="hidden rounded-md bg-brand-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 sm:inline-flex"
      >
        무료 다운로드
      </a>

      <button
        id="mobile-menu-button"
        type="button"
        class="rounded-md p-2 text-zinc-600 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-900 md:hidden"
        aria-label="메뉴 열기"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-zinc-200 dark:border-zinc-800 md:hidden"
  >
    <nav
      class="mx-auto max-w-6xl space-y-1 px-4 py-3 sm:px-6"
      aria-label="모바일 메뉴"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block rounded-md px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/download"
        class="block rounded-md bg-brand-600 px-3 py-2 text-center text-sm font-semibold text-white"
      >
        무료 다운로드
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn?.setAttribute('aria-expanded', String(!!isHidden));
    btn?.setAttribute('aria-label', isHidden ? '메뉴 닫기' : '메뉴 열기');
  });
</script>
