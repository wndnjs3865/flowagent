---
interface Props {
  variant?: 'inline' | 'stacked';
  buttonText?: string;
  placeholder?: string;
  source?: string;
}

const {
  variant = 'inline',
  buttonText = '알림 받을게요',
  placeholder = 'you@example.com',
  source = 'landing',
} = Astro.props;

// Loops form ID is read from PUBLIC_LOOPS_FORM_ID env var.
// To enable submission: set this in Vercel Project Settings →
// Environment Variables (Production + Preview + Development).
//   Key:   PUBLIC_LOOPS_FORM_ID
//   Value: <Loops newsletter form ID> (e.g. cmp2ei3ut1xbj0i02rct8hrht)
// If unset, the form shows an error on submit. The form's source prop
// is sent to Loops as `userGroup` for per-channel lead attribution.
const LOOPS_FORM_ID = import.meta.env.PUBLIC_LOOPS_FORM_ID ?? '';
const LOOPS_ENDPOINT = LOOPS_FORM_ID
  ? `https://app.loops.so/api/newsletter-form/${LOOPS_FORM_ID}`
  : '';
---

<div class="w-full max-w-md">
  <form
    class:list={[
      'flex w-full gap-2',
      variant === 'stacked' && 'flex-col sm:flex-row',
    ]}
    data-email-form
    data-endpoint={LOOPS_ENDPOINT}
    data-source={source}
    data-original-button-text={buttonText}
  >
    <label class="sr-only" for={`email-${source}`}>이메일</label>
    <input
      id={`email-${source}`}
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder={placeholder}
      class="flex-1 rounded-md border border-zinc-300 bg-white px-3.5 py-3 text-base shadow-sm placeholder:text-zinc-400 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 dark:border-zinc-700 dark:bg-zinc-900 dark:placeholder:text-zinc-500"
    />
    <button
      type="submit"
      class="inline-flex shrink-0 items-center justify-center rounded-md bg-brand-600 px-5 py-3 text-base font-semibold text-white shadow-sm hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
    >
      {buttonText}
    </button>
  </form>

  <p
    data-email-result
    class="mt-2 hidden text-sm"
    role="status"
    aria-live="polite"
  >
  </p>
</div>

<script>
  document.querySelectorAll('[data-email-form]').forEach((form) => {
    if (!(form instanceof HTMLFormElement)) return;

    const endpoint = form.dataset.endpoint || '';
    const originalButtonText = form.dataset.originalButtonText || '';
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]'
    );
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const result = form.parentElement?.querySelector<HTMLElement>(
      '[data-email-result]'
    );

    if (!button || !input || !result) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      button.disabled = true;
      button.textContent = '전송 중...';
      result.className = 'mt-2 hidden text-sm';

      const restoreButton = () => {
        button.disabled = false;
        button.textContent = originalButtonText;
      };

      const showSuccess = () => {
        input.value = '';
        result.textContent =
          '신청 접수 완료. 새 소식이 있으면 메일로 알려드릴게요.';
        result.className =
          'mt-2 text-sm text-emerald-600 dark:text-emerald-400';
      };

      const showError = (msg: string) => {
        result.textContent = msg;
        result.className = 'mt-2 text-sm text-red-600 dark:text-red-400';
      };

      try {
        if (!endpoint) {
          // Production should have PUBLIC_LOOPS_FORM_ID set in Vercel env.
          // If missing, fail loudly rather than show fake success — this
          // prevents the silent waitlist=0 bug that masked the env-not-set
          // state during 2026-05-20 smoke test.
          throw new Error('Email form is not configured.');
        }

        // Loops newsletter-form endpoint expects URL-encoded body
        // (multipart/form-data returns 400 "Please enter an email address.").
        // userGroup carries the channel source (e.g. "solo-updates",
        // "landing-hero") so leads can be attributed per channel without
        // setting up custom Loops properties.
        const body = new URLSearchParams();
        body.append('email', input.value);
        body.append('userGroup', form.dataset.source || 'unknown');

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        showSuccess();
      } catch (err) {
        console.error('[EmailForm] submit failed:', err);
        if (err instanceof Error && err.message === 'Email form is not configured.') {
          showError(
            '폼이 현재 사용 불가 상태입니다. wndnjs3865@naver.com 으로 알려주세요.'
          );
        } else {
          showError(
            '전송 실패. 잠시 후 다시 시도하거나 wndnjs3865@naver.com 으로 알려주세요.'
          );
        }
      } finally {
        restoreButton();
      }
    });
  });
</script>
