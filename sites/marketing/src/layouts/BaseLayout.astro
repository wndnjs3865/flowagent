---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  /** Page-specific JSON-LD entries appended to the default @graph. */
  structuredData?: object[];
}

const {
  title = 'FlowAgent — 반복 업무 자동화, 데이터는 내 컴퓨터에',
  description = 'Your workflows are plain YAML files. Your data stays on your machine. 로컬에서 동작하는 AI 자동화 도구.',
  ogImage = '/og.png',
  noIndex = false,
  structuredData = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullOgImage = new URL(ogImage, Astro.site);

// ─── Default JSON-LD: Organization + WebSite (always present) ──────────
const defaultGraph = [
  {
    '@type': 'Organization',
    '@id': 'https://taskflow.kr/#organization',
    name: 'FlowAgent',
    url: 'https://taskflow.kr',
    logo: 'https://taskflow.kr/og.png',
    description:
      'Your workflows are plain YAML files. Your data stays on your machine.',
    sameAs: ['https://github.com/wndnjs3865/flowagent'],
  },
  {
    '@type': 'WebSite',
    '@id': 'https://taskflow.kr/#website',
    url: 'https://taskflow.kr',
    name: 'FlowAgent',
    description,
    publisher: { '@id': 'https://taskflow.kr/#organization' },
    inLanguage: 'ko-KR',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...defaultGraph, ...structuredData],
};
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="FlowAgent" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Theme color (browser chrome) -->
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0a0a0a"
      media="(prefers-color-scheme: dark)"
    />

    <!-- JSON-LD structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />

    <!-- Theme init (avoid FOUC) -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches;
          var isDark = stored ? stored === 'dark' : prefersDark;
          if (isDark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
    >
      본문으로 건너뛰기
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
