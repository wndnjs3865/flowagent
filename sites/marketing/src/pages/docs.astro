---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailForm from '../components/EmailForm.astro';

const REPO_URL = 'https://github.com/wndnjs3865/flowagent';
const README_URL = `${REPO_URL}#readme`;
---

<BaseLayout
  title="문서 — FlowAgent"
  description="FlowAgent 문서 — Quickstart, YAML 스키마, Troubleshooting. 정식 문서 사이트 준비 중."
>
  <!-- ───────────────────────────────────────────────────────  HERO  ─── -->
  <section class="border-b border-zinc-200 dark:border-zinc-800">
    <div
      class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 sm:py-20"
    >
      <div
        class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800 dark:border-amber-900 dark:bg-amber-950/50 dark:text-amber-300"
      >
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        Coming Soon · 정식 문서 사이트 준비 중
      </div>

      <h1
        class="mt-5 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50"
      >
        문서
      </h1>
      <p
        class="mx-auto mt-4 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400"
      >
        아래는 핵심 내용 요약입니다. 곧 풀 문서 사이트로 확장할 예정 — 그
        전까진 GitHub README와 이 페이지로 안내드려요.
      </p>
    </div>
  </section>

  <!-- ───────────────────────────────────────  QUICKSTART  ─── -->
  <section class="border-b border-zinc-200 dark:border-zinc-800">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <div
          class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400"
        >
          01 · Quickstart
        </div>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100"
        >
          1분 안에 첫 워크플로우 실행
        </h2>
        <p class="mt-3 text-zinc-600 dark:text-zinc-400">
          설치 마법사 없음. 압축 풀고 더블클릭 한 번이면 끝.
        </p>
      </div>

      <ol class="mt-8 grid gap-4 md:grid-cols-3">
        <li class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950">
          <div class="font-mono text-xs font-semibold text-brand-600 dark:text-brand-400">
            STEP 1
          </div>
          <h3 class="mt-2 text-base font-semibold text-zinc-900 dark:text-zinc-100">
            압축 풀기
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            <a href="/download" class="text-brand-600 underline-offset-4 hover:underline dark:text-brand-400">다운로드</a>한
            <code class="rounded bg-zinc-100 px-1 py-0.5 font-mono text-xs dark:bg-zinc-900">.zip</code>을 원하는 폴더에 압축 해제.
          </p>
        </li>
        <li class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950">
          <div class="font-mono text-xs font-semibold text-brand-600 dark:text-brand-400">
            STEP 2
          </div>
          <h3 class="mt-2 text-base font-semibold text-zinc-900 dark:text-zinc-100">
            start.bat 더블클릭
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            Windows. Node·pnpm 자동 설치 + 서버 시작. macOS·Linux는 터미널에서
            <code class="rounded bg-zinc-100 px-1 py-0.5 font-mono text-xs dark:bg-zinc-900">pnpm install && pnpm dev</code>.
          </p>
        </li>
        <li class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-950">
          <div class="font-mono text-xs font-semibold text-brand-600 dark:text-brand-400">
            STEP 3
          </div>
          <h3 class="mt-2 text-base font-semibold text-zinc-900 dark:text-zinc-100">
            브라우저 자동 오픈
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            <code class="rounded bg-zinc-100 px-1 py-0.5 font-mono text-xs dark:bg-zinc-900">localhost:3000</code>에서
            카드 클릭으로 실행. 결과는 SSE로 실시간 스트리밍.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ───────────────────────────────────────  YAML SCHEMA  ─── -->
  <section
    class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900"
  >
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
      <div class="max-w-2xl">
        <div
          class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400"
        >
          02 · YAML 스키마
        </div>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100"
        >
          워크플로우 한 파일 구조
        </h2>
        <p class="mt-3 text-zinc-600 dark:text-zinc-400">
          <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-sm dark:bg-zinc-950">workflows/&lt;slug&gt;.yaml</code>로 저장하면 자동 감지. 다른 의존성 없음.
        </p>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div
          class="overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-950"
        >
          <div class="flex items-center gap-2 px-4 py-2.5 border-b border-zinc-200 dark:border-zinc-800">
            <div class="h-2.5 w-2.5 rounded-full bg-red-400"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-yellow-400"></div>
            <div class="h-2.5 w-2.5 rounded-full bg-green-400"></div>
            <span class="ml-2 font-mono text-xs text-zinc-500 dark:text-zinc-500">
              workflows/example.yaml
            </span>
          </div>
          <pre
            class="overflow-x-auto bg-zinc-950 p-5 font-mono text-xs leading-relaxed text-zinc-100"><code><span class="text-zinc-400">name:</span> <span class="text-amber-300">example</span>
<span class="text-zinc-400">description:</span> <span class="text-amber-300">"한 줄 설명 (카드에 표시됨)"</span>
<span class="text-zinc-400">category:</span> <span class="text-amber-300">"운영 / PM"</span>
<span class="text-zinc-400">persona:</span> <span class="text-amber-300">"매니저·리드"</span>

<span class="text-zinc-400">steps:</span>
  - <span class="text-zinc-400">id:</span> <span class="text-amber-300">load</span>
    <span class="text-zinc-400">run:</span> <span class="text-emerald-300">shell</span>
    <span class="text-zinc-400">cmd:</span> <span class="text-amber-300">cat data.csv</span>

  - <span class="text-zinc-400">id:</span> <span class="text-amber-300">summarize</span>
    <span class="text-zinc-400">run:</span> <span class="text-emerald-300">llm</span>
    <span class="text-zinc-400">prompt:</span> |
      <span class="text-amber-300">아래를 1-pager로 요약:</span>
      <span class="text-amber-300">&#123;&#123; load.stdout &#125;&#125;</span></code></pre>
        </div>

        <div class="space-y-4">
          <div>
            <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">
              필드 빠른 참조
            </h3>
            <dl class="mt-3 space-y-2 text-sm">
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  name
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">파일명 기준 slug — 카드에 표시</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  description
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">카드 본문 한 줄</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  category
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">분류 뱃지 (영업관리·운영·총무 등)</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  persona
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">페르소나 필터 키 (선택)</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  steps[].id
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">단계 식별자 — 다른 단계가
                  <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">&#123;&#123; id.stdout &#125;&#125;</code>로 참조</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  steps[].run
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">
                  <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">llm</code> 또는
                  <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">shell</code>
                </dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  steps[].prompt
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">LLM 단계 프롬프트 (Claude 호출)</dd>
              </div>
              <div class="flex gap-3">
                <dt class="w-28 shrink-0 font-mono text-xs text-brand-600 dark:text-brand-400">
                  steps[].cmd
                </dt>
                <dd class="text-zinc-600 dark:text-zinc-400">셸 단계 명령어 (sandboxed)</dd>
              </div>
            </dl>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-500">
            정식 풀 스키마는 곧 별도 문서로. 현재는 5개 기본 워크플로우 (
            <a
              href="/templates"
              class="underline-offset-4 hover:text-zinc-900 hover:underline dark:hover:text-zinc-100"
              >템플릿</a
            >
            페이지)에서 실제 작성 예시 참고.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────────────────────  TROUBLESHOOTING  ─── -->
  <section class="border-b border-zinc-200 dark:border-zinc-800">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
      <div
        class="text-xs font-mono font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400"
      >
        03 · Troubleshooting
      </div>
      <h2
        class="mt-3 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100"
      >
        자주 마주치는 문제
      </h2>

      <div class="mt-8 divide-y divide-zinc-200 dark:divide-zinc-800">
        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between text-base font-medium text-zinc-900 dark:text-zinc-100"
          >
            start.bat 더블클릭 시 검은 창이 떴다가 즉시 닫혀요
            <svg
              class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            대부분 줄바꿈(LF/CRLF) 또는 cmd 파싱 문제입니다. v0.1.0에서 fix
            되었으니 GitHub Release 최신본을 다시 다운받아 보세요. 그래도
            문제면 cmd 창에서 직접
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">start.bat</code>을
            실행해 에러 메시지를 확인할 수 있어요.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between text-base font-medium text-zinc-900 dark:text-zinc-100"
          >
            "포트 3000이 사용 중" 에러
            <svg class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            <p>이미 다른 FlowAgent 인스턴스 또는 다른 프로그램이 3000번 포트를
              점유 중입니다. 종료 후 재시작하거나, 환경변수
              <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">PORT=3001</code>로
              포트를 바꿔 실행하세요.</p>
            <pre class="mt-2 overflow-x-auto rounded bg-zinc-950 p-3 font-mono text-xs text-zinc-100"><code># Windows (PowerShell)
$env:PORT=3001; pnpm dev

# macOS / Linux
PORT=3001 pnpm dev</code></pre>
          </div>
        </details>

        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between text-base font-medium text-zinc-900 dark:text-zinc-100"
          >
            API 키를 입력했는데도 LLM 단계가 실패해요
            <svg class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">.env</code> 파일의
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">ANTHROPIC_API_KEY=</code> 뒤에
            공백·따옴표 없이 키를 붙여넣었는지 확인하세요.
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">sk-ant-</code>로 시작하는 게 정상입니다.
            저장 후 서버를 한 번 재시작 (cmd 창 닫고 start.bat 다시 더블클릭).
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between text-base font-medium text-zinc-900 dark:text-zinc-100"
          >
            워크플로우 카드가 안 보여요
            <svg class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">workflows/</code> 디렉토리에
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">.yaml</code> 파일이 있는지 확인.
            파일명이 <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">_</code> (언더스코어)로 시작하면
            템플릿으로 분류되어 카드에 노출되지 않습니다.
            YAML 문법 오류 시 카드가 빠질 수 있으니
            <a href="https://www.yamllint.com" class="underline-offset-4 hover:text-zinc-900 hover:underline dark:hover:text-zinc-100" rel="noopener">yamllint.com</a>으로 검증해 보세요.
          </p>
        </details>

        <details class="group py-5">
          <summary
            class="flex cursor-pointer items-center justify-between text-base font-medium text-zinc-900 dark:text-zinc-100"
          >
            macOS / Linux에서 start.bat가 안 돼요
            <svg class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
            맞아요, <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">start.bat</code>은 Windows 전용입니다.
            macOS·Linux에서는 터미널에서
            <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">pnpm install && pnpm dev</code>로 직접 실행하세요.
            v0.2.0에서 <code class="rounded bg-zinc-100 px-1 font-mono text-xs dark:bg-zinc-900">start.sh</code> 동등 스크립트 추가 예정.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ───────────────────────────────────────  FOOTER CTA  ─── -->
  <section>
    <div
      class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20"
    >
      <p class="text-lg font-medium text-zinc-700 dark:text-zinc-300">
        Your workflows are <span class="font-semibold text-zinc-900 dark:text-zinc-100">plain YAML files</span>.<br />
        Your data stays on <span class="font-semibold text-zinc-900 dark:text-zinc-100">your machine</span>.
      </p>
      <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-500">
        더 자세한 정보는 GitHub README와 소스 코드를 참고하세요.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={README_URL}
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-zinc-300 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
        >
          GitHub README 보기 ↗
        </a>
        <a
          href="/download"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
        >
          무료 다운로드
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
