---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailForm from '../components/EmailForm.astro';

const REPO_URL = 'https://github.com/wndnjs3865/flowagent';
const WORKFLOWS_DIR_URL = `${REPO_URL}/tree/main/workflows`;
---

<BaseLayout
  title="1인 자영업 · 프리랜서 — FlowAgent"
  description="견적 메일 워크플로 사용 가능 · 영업 후처리 · SNS 답글 2종 진행 중. 1인 자영업·프리랜서를 위한 B 페르소나 신규 3종."
>
  <section class="border-b border-zinc-200 dark:border-zinc-800">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-20">
      <div
        class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        1/3 완료 · 견적 메일 사용 가능, 2종 진행 중
      </div>
      <h1
        class="mt-5 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50"
      >
        견적·응대·SNS,<br />
        <span class="text-brand-600 dark:text-brand-400">매일 반복되는 일감을 줄이고</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
        1인 디자이너·강사·컨설턴트·소상공인에게. 영업·견적·고객 응대까지 모두 본인이 처리하는 분께. 3종 신규 워크플로 중 견적 메일은 지금 바로 사용, 나머지 2종은 4주 안에 순차 추가.
      </p>
      <div class="mt-8 flex justify-start">
        <EmailForm
          variant="inline"
          source="solo-waitlist"
          buttonText="나머지 2종 알림 받을게요"
          placeholder="이메일을 알려주세요"
        />
      </div>
      <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-500">
        스팸 없음 · 새 워크플로 출시 1회만 알림 · 메일 주소만 사용
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-100">
        3종 워크플로 — 1/3 진행 중
      </h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <div class="rounded-2xl border border-emerald-200 bg-white p-6 dark:border-emerald-900 dark:bg-zinc-950">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">견적 메일 작성</h3>
            <span class="shrink-0 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">
              사용 가능
            </span>
          </div>
          <ul class="mt-3 space-y-1.5 text-sm text-zinc-600 dark:text-zinc-400">
            <li>• 프로젝트 brief + 본인 단가 가이드</li>
            <li>• 견적 항목·금액·부가세 자동 산정</li>
            <li>• 고객 회신 메일 그대로 복사</li>
          </ul>
          <div class="mt-4 border-t border-zinc-200 pt-3 dark:border-zinc-800">
            <a
              href={`${WORKFLOWS_DIR_URL}/quote-email.yaml`}
              rel="noopener"
              class="text-xs text-brand-600 underline-offset-4 hover:underline dark:text-brand-400"
            >
              quote-email.yaml 소스 보기 ↗
            </a>
          </div>
        </div>
        <div class="rounded-2xl border border-dashed border-zinc-300 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-950">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">영업 후처리</h3>
            <span class="shrink-0 rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
              Coming
            </span>
          </div>
          <ul class="mt-3 space-y-1.5 text-sm text-zinc-600 dark:text-zinc-400">
            <li>• 미팅·통화 노트 → 다음 액션 분류</li>
            <li>• Follow-up 메일 초안</li>
            <li>• 다음 일정 제안까지</li>
          </ul>
          <p class="mt-4 border-t border-zinc-200 pt-3 text-xs italic text-zinc-500 dark:border-zinc-800 dark:text-zinc-500">
            예정: 약 2주 후
          </p>
        </div>
        <div class="rounded-2xl border border-dashed border-zinc-300 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-950">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">SNS 답글 작성</h3>
            <span class="shrink-0 rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
              Coming
            </span>
          </div>
          <ul class="mt-3 space-y-1.5 text-sm text-zinc-600 dark:text-zinc-400">
            <li>• 인스타·블로그 댓글 분류</li>
            <li>• 카테고리별 답글 초안</li>
            <li>• 신고·스팸 거름망</li>
          </ul>
          <p class="mt-4 border-t border-zinc-200 pt-3 text-xs italic text-zinc-500 dark:border-zinc-800 dark:text-zinc-500">
            예정: 약 4주 후
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
