---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailForm from '../components/EmailForm.astro';

// ─── Pricing constants (단위: 원, KRW) ─────────────────────────────────
const PRO_MONTHLY = 12000;
const PRO_YEARLY = 115200; // 12000 * 12 * 0.8 (20% off)
const PRO_YEARLY_PER_MONTH = 9600; // 115200 / 12
const TEAM_MONTHLY = 20000;
const TEAM_YEARLY = 192000; // 20000 * 12 * 0.8
const TEAM_YEARLY_PER_MONTH = 16000;
const TEAM_MIN_SEATS = 3;
const ANNUAL_DISCOUNT_PCT = 20;

const fmt = (n: number) => new Intl.NumberFormat('ko-KR').format(n);

// ─── JSON-LD: Product + offers for each plan ───────────────────────────
const productSchema = {
  '@type': 'Product',
  name: 'FlowAgent',
  description:
    '로컬-first AI 워크플로우 자동화. 워크플로우는 plain YAML 파일, 데이터는 사용자 컴퓨터에 저장.',
  brand: { '@id': 'https://taskflow.kr/#organization' },
  url: 'https://taskflow.kr/pricing',
  offers: [
    {
      '@type': 'Offer',
      name: 'Free',
      price: '0',
      priceCurrency: 'KRW',
      availability: 'https://schema.org/InStock',
      description: '평생 무료. 워크플로우·실행 횟수 무제한.',
    },
    {
      '@type': 'Offer',
      name: 'Pro',
      price: String(PRO_MONTHLY),
      priceCurrency: 'KRW',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: PRO_MONTHLY,
        priceCurrency: 'KRW',
        unitText: 'MONTH',
      },
      availability: 'https://schema.org/PreOrder',
      description: '3 기기 sync · 프리미엄 템플릿 · 이메일 우선 지원. 약 1개월 뒤 출시.',
    },
    {
      '@type': 'Offer',
      name: 'Team',
      price: String(TEAM_MONTHLY),
      priceCurrency: 'KRW',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: TEAM_MONTHLY,
        priceCurrency: 'KRW',
        unitText: 'MONTH',
      },
      availability: 'https://schema.org/PreOrder',
      description: `시트당 가격. 최소 ${TEAM_MIN_SEATS}시트. 팀 워크스페이스 + 공유 워크플로우 + 감사 로그.`,
    },
  ],
};

// ─── Comparison matrix (§5의 매트릭스) ─────────────────────────────────
type Cell = true | false | string;
type Row = { label: string; cells: [Cell, Cell, Cell, Cell] };
type Group = { category: string; rows: Row[] };

const compareGroups: Group[] = [
  {
    category: '코어 (전 플랜 공통)',
    rows: [
      { label: '워크플로우 수', cells: ['무제한', '무제한', '무제한', '무제한'] },
      { label: '실행 횟수', cells: ['무제한', '무제한', '무제한', '무제한'] },
      { label: '로컬 데이터 저장', cells: [true, true, true, true] },
      { label: '오픈소스 (git clone)', cells: [true, true, true, true] },
      { label: 'API 키 본인 소유', cells: [true, true, true, true] },
      { label: '자동 업데이트', cells: [true, true, true, '관리자 제어'] },
      { label: '기본 템플릿 갤러리', cells: [true, true, true, true] },
    ],
  },
  {
    category: 'Sync & 백업',
    rows: [
      { label: 'Multi-device sync', cells: [false, '3 devices', '시트당', '무제한'] },
      { label: 'Cloud run history backup', cells: [false, '90일', '1년', '무제한'] },
      { label: '설정 sync', cells: [false, true, true, true] },
      { label: 'E2E 암호화', cells: [false, true, true, true] },
    ],
  },
  {
    category: '팀 협업',
    rows: [
      { label: 'Team workspace', cells: [false, false, true, true] },
      { label: 'Shared workflows', cells: [false, false, true, true] },
      { label: '권한 관리 (admin/member)', cells: [false, false, true, '커스텀 역할'] },
      { label: '감사 로그 (audit)', cells: [false, false, '30일', '무제한 + export'] },
    ],
  },
  {
    category: '템플릿 & API',
    rows: [
      { label: '프리미엄 템플릿', cells: [false, '월 1-2개', true, '커스텀 가능'] },
      { label: '팀 전용 템플릿', cells: [false, false, true, true] },
      { label: '개인 API 토큰', cells: [false, true, true, true] },
    ],
  },
  {
    category: '엔터프라이즈',
    rows: [
      { label: 'SSO / SAML', cells: [false, false, false, true] },
      { label: '자체 호스팅 Sync 서버', cells: [false, false, '옵션', true] },
      { label: 'Vault 연동 (사내 키 관리)', cells: [false, false, false, true] },
      { label: '사업자 인보이스 / 세금계산서', cells: [false, true, true, true] },
    ],
  },
  {
    category: '지원',
    rows: [
      { label: '지원 채널', cells: ['커뮤니티', 'Email 48h', 'Slack 24h', '전담 CSM'] },
      { label: '온보딩 세션', cells: [false, false, '1회 무료', '맞춤 진행'] },
    ],
  },
];
---

<BaseLayout
  title="가격 — FlowAgent"
  description="Free는 평생 무료. Pro 12,000원/월부터. 워크플로우 개수·실행 횟수에는 제한이 없어요. 결제는 여러 기기 sync와 팀 협업이 필요할 때부터."
  ogImage="/og-pricing.png"
  structuredData={[productSchema]}
>
  <!-- ───────────────────────────────────────────────────────  HERO  ─── -->
  <section class="border-b border-zinc-200 dark:border-zinc-800">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center sm:px-6 sm:py-20">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800 dark:border-amber-900 dark:bg-amber-950/50 dark:text-amber-300"
      >
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        약 1개월 뒤 Pro 출시 예정
      </div>

      <h1
        class="mt-5 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50"
      >
        가격
      </h1>
      <p
        class="mx-auto mt-4 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400"
      >
        Free는 평생 무료. 결제는 <span
          class="font-semibold text-zinc-900 dark:text-zinc-100"
          >여러 기기 sync</span
        >나 <span
          class="font-semibold text-zinc-900 dark:text-zinc-100"
          >팀 공유</span
        >가 필요해질 때부터.
      </p>
    </div>
  </section>

  <!-- ───────────────────────────────────────  BILLING TOGGLE  ─── -->
  <section>
    <div class="mx-auto max-w-6xl px-4 pt-10 sm:px-6">
      <div class="flex flex-col items-center gap-3">
        <div
          class="inline-flex items-center gap-1 rounded-full border border-zinc-200 bg-zinc-50 p-1 dark:border-zinc-800 dark:bg-zinc-900"
          role="tablist"
          aria-label="결제 주기 선택"
        >
          <button
            type="button"
            data-billing="monthly"
            class="rounded-full bg-white px-4 py-1.5 text-sm font-medium text-zinc-900 shadow-sm dark:bg-zinc-950 dark:text-zinc-100"
            aria-selected="true"
            role="tab"
          >
            월간 결제
          </button>
          <button
            type="button"
            data-billing="yearly"
            class="rounded-full px-4 py-1.5 text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            aria-selected="false"
            role="tab"
          >
            연간 결제
            <span
              class="ml-1.5 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300"
              >20% 할인</span
            >
          </button>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-500">
          표시는 원화(KRW), 부가세 별도. 사업자등록증 첨부 시 세금계산서 발행.
        </p>
      </div>
    </div>
  </section>

  <!-- ───────────────────────────────────────  4 PRICING CARDS  ─── -->
  <section>
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-12">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        <!-- ─── FREE ─── -->
        <div
          class="relative flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950"
        >
          <div
            class="absolute right-4 top-4 inline-flex rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300"
          >
            노트북 1대 · 평생 무료
          </div>
          <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
            Free
          </div>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">
            회사 데이터, 노트북 안에만
          </p>
          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span
                class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
                >₩0</span
              >
              <span class="text-sm text-zinc-500 dark:text-zinc-500">/영구</span>
            </div>
            <p class="mt-1 h-4 text-xs text-zinc-500 dark:text-zinc-500"></p>
          </div>
          <a
            href="/download"
            class="mt-5 inline-flex items-center justify-center rounded-md border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:bg-zinc-800"
          >
            지금 다운로드
          </a>
          <ul class="mt-6 space-y-2.5 text-sm text-zinc-700 dark:text-zinc-300">
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              워크플로우 무제한
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              실행 횟수 무제한
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              모든 데이터 로컬
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              오픈소스 · git clone
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              자동 업데이트
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              커뮤니티 지원
            </li>
          </ul>
        </div>

        <!-- ─── PRO (recommended) ─── -->
        <div
          class="relative flex flex-col rounded-2xl border-2 border-brand-500 bg-white p-6 shadow-lg dark:border-brand-400 dark:bg-zinc-950"
        >
          <div
            class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-amber-500 px-3 py-1 text-xs font-semibold text-white"
          >
            곧 출시 · 약 1개월
          </div>
          <div class="text-sm font-semibold text-brand-600 dark:text-brand-400">
            Pro
          </div>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">
            여러 기기 sync, 우선 지원
          </p>
          <div class="mt-5">
            <div data-price-monthly class="flex items-baseline gap-1">
              <span
                class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
                >₩{fmt(PRO_MONTHLY)}</span
              >
              <span class="text-sm text-zinc-500 dark:text-zinc-500">/월</span>
            </div>
            <div data-price-yearly class="hidden">
              <div class="flex items-baseline gap-1">
                <span
                  class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
                  >₩{fmt(PRO_YEARLY_PER_MONTH)}</span
                >
                <span class="text-sm text-zinc-500 dark:text-zinc-500">/월</span>
              </div>
              <p class="mt-1 text-xs text-emerald-600 dark:text-emerald-400">
                연 ₩{fmt(PRO_YEARLY)} 청구 · {ANNUAL_DISCOUNT_PCT}% 할인
              </p>
            </div>
            <p
              data-price-monthly-note
              class="mt-1 h-4 text-xs text-zinc-500 dark:text-zinc-500"
            >
              연간 결제 시 {ANNUAL_DISCOUNT_PCT}% 할인
            </p>
          </div>
          <button
            type="button"
            class="mt-5 inline-flex items-center justify-center rounded-md bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
            data-scroll-to="#waitlist"
          >
            Pro 출시 알림 받기
          </button>
          <ul class="mt-6 space-y-2.5 text-sm text-zinc-700 dark:text-zinc-300">
            <li class="flex items-start gap-2 font-medium text-zinc-900 dark:text-zinc-100">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              Free 모든 기능 +
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              3개 기기까지 sync (E2E 암호화)
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              실행 이력 90일 클라우드 백업
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              프리미엄 템플릿 (월 1-2개 신규)
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              개인 API 토큰
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              이메일 우선 지원 (48시간 내)
            </li>
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
              사업자 인보이스 발행
            </li>
          </ul>
        </div>

        <!-- ─── TEAM ─── -->
        <div
          class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-950"
        >
          <div class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">
            Team
          </div>
          <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">
            동료와 같은 워크플로우 공유
          </p>
          <div class="mt-5">
            <div data-price-monthly class="flex items-baseline gap-1">
              <span
                class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
                >₩{fmt(TEAM_MONTHLY)}</span
              >
              <span class="text-sm text-zinc-500 dark:text-zinc-500"
                >/시트/월</span
              >
            </div>
            <div data-price-yearly class="hidden">
              <div class="flex items-baseline gap-1">
                <span
                  class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100"
                  >₩{fmt(TEAM_YEARLY_PER_MONTH)}</span
                >
                <span class="text-sm text-zinc-500 dark:text-zinc-500"
                  >/시트/월</span
                >
              </div>
              <p class="mt-1 text-xs text-emerald-600 dark:text-emerald-400">
                연 ₩{fmt(TEAM_YEARLY)}/시트 · {ANNUAL_DISCOUNT_PCT}% 할인
              </p>
            </div>
            <p class="mt-1 h-4 text-xs text-zinc-500 dark:text-zinc-500">
              {TEAM_MIN_SEATS} 시트부터 · 연간 결제 시 {ANNUAL_DISCOUNT_PCT}% 할인
            </p>
          </div>
