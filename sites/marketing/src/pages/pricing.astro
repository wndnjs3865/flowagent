<script>
  // ─── Billing toggle (월간 / 연간) ──────────────────────────────────
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-billing]');
  const monthlyEls = document.querySelectorAll<HTMLElement>('[data-price-monthly]');
  const yearlyEls = document.querySelectorAll<HTMLElement>('[data-price-yearly]');

  const setBilling = (mode: 'monthly' | 'yearly') => {
    monthlyEls.forEach((el) => el.classList.toggle('hidden', mode !== 'monthly'));
    yearlyEls.forEach((el) => el.classList.toggle('hidden', mode !== 'yearly'));

    buttons.forEach((btn) => {
      const active = btn.dataset.billing === mode;
      btn.setAttribute('aria-selected', String(active));
      if (active) {
        btn.classList.add('bg-white', 'text-zinc-900', 'shadow-sm', 'dark:bg-zinc-950', 'dark:text-zinc-100');
        btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');
      } else {
        btn.classList.remove('bg-white', 'text-zinc-900', 'shadow-sm', 'dark:bg-zinc-950', 'dark:text-zinc-100');
        btn.classList.add('text-zinc-600', 'dark:text-zinc-400');
      }
    });
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.billing as 'monthly' | 'yearly';
      setBilling(mode);
    });
  });

  // ─── Scroll-to-anchor on CTA clicks ────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('[data-scroll-to]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.scrollTo;
      if (!target) return;
      const el = document.querySelector(target);
      el?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
