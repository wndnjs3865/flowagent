ANTHROPIC_API_KEY=
PORT=3000
FLOWAGENT_WORKFLOWS_DIR=workflows
FLOWAGENT_RUNS_DIR=runs
# Pilot CTA banner — plain email. Server builds the mailto URL with a fixed
# Korean subject. Defaults to the FlowAgent official sales channel
# (사업자등록번호 607-20-94796). Override only if you fork for your own sales.
FLOWAGENT_PILOT_CONTACT_EMAIL=wndnjs3865@naver.com

# Optional — set to enable /share/* signed-URL mobile sharing (spec § 5 옵션 2).
# Generate a strong secret (min 32 bytes) with:
#   PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   bash/macOS:  openssl rand -base64 32
# Short or empty secrets are rejected at runtime. If unset entirely, the share
# UI is hidden and /share/* returns 503 with an instruction page.
# NEVER commit this value to git.
# FLOWAGENT_SHARE_SECRET=

# Optional — public origin for the share URLs (e.g. https://flowagent.example.com).
# When set, /share/new builds URLs using this origin instead of the request's
# Host/Proto headers. Useful behind a reverse proxy (nginx, Cloudflare) where
# the Node server sees localhost but the user-facing URL is the public domain.
# If unset, x-forwarded-proto/x-forwarded-host headers are honored when present,
# falling back to the request URL.
# FLOWAGENT_PUBLIC_ORIGIN=
